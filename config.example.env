# Bez sekretów. Właściwy plik umieść POZA public/ i repozytorium.
BOOKING_MODE=preview
PUBLIC_ORIGIN=https://onkolog-szyburski.pl
BOOKING_DATA_DIR=/var/lib/onkolog-booking
BOOKING_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Dokładne adresy lekarza i asystentki, bez spacji między adresami.
STAFF_EMAILS=
# Numery odbierające SMS, rozdzielone przecinkiem; puste = SMS wyłączony.
STAFF_SMS=
SMSAPI_TOKEN=
SMSAPI_SENDER=
# Prywatny, osobny kalendarz. Puste = Google wyłączone.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/onkolog-booking/google-service-account.json
